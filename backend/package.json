{
  "type": "module",
  "name": "webii",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon main.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:bo": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js -c ./testing/jest.config.mjs --runInBand",
    "test:bo:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js -c ./testing/jest.config.mjs --watch",
    "test:bo:setup-db": "docker compose -f ./testing/docker-compose.test.yml down -v && docker compose -f ./testing/docker-compose.test.yml up -d --wait",
    "test:bo:teardown-db": "docker compose -f ./testing/docker-compose.test.yml down -v",
    "test:bo:full": "npm run test:bo:setup-db && npm run test:bo && npm run test:bo:teardown-db",
    "test:session-sanitizer": "node test_session_sanitizer.js",
    "test:session-http": "node test_session_http.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DonMiguels/Web-II.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DonMiguels/Web-II/issues"
  },
  "homepage": "https://github.com/DonMiguels/Web-II#readme",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.18.0",
    "resend": "^4.0.0",
    "yaml": "^2.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.14"
  }
}
