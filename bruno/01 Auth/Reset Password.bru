meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/user/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "PEGAR_TOKEN_DEL_EMAIL",
    "password": "Bruno123!@#"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Requiere el token del email de forgot-password. Único request que necesita pegar un valor.
}
