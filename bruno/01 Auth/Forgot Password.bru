meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/user/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@sistema.local"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Solicita reset. Usa un email real de la DB si quieres recibir el correo.
}
